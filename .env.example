# ---------------------------------------------------------------------------
# WeatherGPT configuration. Copy to `.env` and fill in what you have.
# Every value has a working default; nothing here is required to start.
# ---------------------------------------------------------------------------

# --- Anthropic --------------------------------------------------------------
# Without a key the app still runs: understanding falls back to rule-based
# extraction and answers to localised templates. Quality drops, uptime does not.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=25
LLM_ENABLED=true

# --- Weather data -----------------------------------------------------------
# live    = real Open-Meteo calls (default; no API key needed)
# fixture = deterministic offline snapshots for dev/CI. Responses are marked
#           data_source="fixture" and the UI shows a SIMULATED banner.
WEATHER_DATA_MODE=live
WEATHER_CACHE_SECONDS=600
WEATHER_TIMEOUT_SECONDS=12

# Swap these for an IMD/NOAA mirror without touching route code.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# --- Database ---------------------------------------------------------------
WEATHERGPT_DB=./weathergpt.db

# --- Alert scheduler --------------------------------------------------------
SCHEDULER_ENABLED=true
ALERT_INTERVAL_MINUTES=30
ALERT_MIN_RISK_SCORE=61        # 61 = the "High" band from the risk engine
ALERT_DEDUP_HOURS=6

# --- Twilio SMS (optional) --------------------------------------------------
# Unset means alerts are logged to the console instead of texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Speech -----------------------------------------------------------------
WHISPER_MODEL=base             # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu
MAX_AUDIO_BYTES=20971520
MAX_AUDIO_SECONDS=120
TTS_ENABLED=true

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
