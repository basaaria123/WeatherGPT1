# ---------------------------------------------------------------------------
# WeatherGPT configuration. Copy to `.env` and fill in what you have.
# Every value has a working default; nothing here is required to start.
# ---------------------------------------------------------------------------

# --- Chatbot (Gemini or Anthropic) ------------------------------------------
# Without any key the app still runs: understanding falls back to rule-based
# extraction and answers to localised templates. Quality drops, uptime does not.
#
# LLM_PROVIDER: gemini | anthropic | auto (auto prefers Gemini when its key is
# set). Naming a provider whose key is missing uses no LLM at all rather than
# silently answering from the other one.
LLM_PROVIDER=auto

GEMINI_API_KEY=your_gemini_api_key
# gemini-3.5-flash-lite answers in about a second. The larger flash models
# return 503 "high demand" often enough to be a poor demo default.
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_ENABLED=true

# --- Weather data -----------------------------------------------------------
# live    = real Open-Meteo calls (default; no API key needed)
# fixture = deterministic offline snapshots for dev/CI. Responses are marked
#           data_source="fixture" and the UI shows a SIMULATED banner.
WEATHER_DATA_MODE=live
WEATHER_CACHE_SECONDS=600
WEATHER_TIMEOUT_SECONDS=12

# Swap these for an IMD/NOAA mirror without touching route code.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# --- Database ---------------------------------------------------------------
WEATHERGPT_DB=./weathergpt.db

# --- Alert scheduler --------------------------------------------------------
SCHEDULER_ENABLED=true
ALERT_INTERVAL_MINUTES=30
ALERT_MIN_RISK_SCORE=61        # 61 = the "High" band from the risk engine
ALERT_DEDUP_HOURS=6

# --- Twilio SMS (optional) --------------------------------------------------
# Unset means alerts are logged to the console instead of texted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Speech to text ---------------------------------------------------------
# ElevenLabs Scribe is used when a key is set. It needs no model download,
# which is what makes voice input work on a serverless host where Whisper's
# weights cannot be fetched. If a request to it fails and a local Whisper is
# installed, that is used instead; otherwise the browser's own recognition
# result is accepted as `client_transcript`.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# The same key drives synthesis. ElevenLabs is the primary voice; when it is
# absent or unreachable the server falls through to gTTS and then to pyttsx3,
# and the browser falls through to Puter and its own synthesiser after that.
# `eleven_multilingual_v2` is the model that actually speaks the Indic
# languages this app offers.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Any voice id from your ElevenLabs library; the default is a public one.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_TIMEOUT_SECONDS=12
ELEVENLABS_STT_MODEL=scribe_v1  # scribe_v1 | scribe_v2
ELEVENLABS_TIMEOUT_SECONDS=30

WHISPER_MODEL=base             # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu
MAX_AUDIO_BYTES=20971520
MAX_AUDIO_SECONDS=120
TTS_ENABLED=true

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
